# Copy this file to .env before running Docker Compose.
# Do not commit real secrets or GCP credential files.

# Local Postgres source database
SOURCE_POSTGRES_DB=ecommerce
SOURCE_POSTGRES_USER=ecommerce_user
SOURCE_POSTGRES_PASSWORD=ecommerce_password
SOURCE_POSTGRES_PORT_HOST=5432

# Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_POSTGRES_PORT_HOST=5433

# Airflow web UI
AIRFLOW_UID=1000
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_to_a_long_random_string
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# GCP settings
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=${HOME}/.gcp/ecommerce-dw-runner.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/ecommerce-dw-runner.json

# Put the service account JSON outside the project directory.
# WSL2 example: ~/.gcp/ecommerce-dw-runner.json
# This file is not created by the project and must not be committed.

# BigQuery datasets
BQ_LOCATION=US
BQ_RAW_DATASET=ecommerce_raw
BQ_STAGING_DATASET=ecommerce_staging
BQ_CORE_DATASET=ecommerce_core
BQ_MART_DATASET=ecommerce_mart
BQ_AUDIT_DATASET=ecommerce_audit
DBT_DATASET=ecommerce_staging

# Installed into Airflow containers at runtime for local development.
_PIP_ADDITIONAL_REQUIREMENTS=dbt-bigquery==1.8.2 google-cloud-storage==2.18.2 google-cloud-bigquery==3.25.0 pandas==2.2.2 pyarrow==17.0.0 Faker==28.4.1 psycopg2-binary==2.9.9
